{
  "name": "qqbot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "description": "QQ group AI chat bot powered by Koishi + OneBot on Fedora/Podman",
  "scripts": {
    "chatluna:build": "bash ./scripts/ensure-chatluna-build.sh",
    "build": "bash ./scripts/build-runtime.sh",
    "build:runtime": "bash ./scripts/build-runtime.sh",
    "admin:build": "vite build --config apps/admin-web/vite.config.ts",
    "admin:dev": "vite --config apps/admin-web/vite.config.ts",
    "admin:typecheck": "vue-tsc --noEmit -p apps/admin-web/tsconfig.json",
    "dev": "pnpm start",
    "docs:dev": "vitepress dev web",
    "docs:build": "vitepress build web",
    "docs:preview": "vitepress preview web",
    "runtime:check": "bash ./scripts/ensure-chatluna-build.sh --check && node ./scripts/verify-runtime-artifacts.mjs --config koishi.yml",
    "context-presets:build": "node ./scripts/build-context-preset-cutover-tools.mjs && node ./scripts/build-model-config-cutover-tool.mjs",
    "context-presets:preflight": "node ./dist/tools/context-preset-cutover.mjs preflight",
    "context-presets:apply": "node ./dist/tools/context-preset-cutover.mjs apply",
    "model-config:build": "node ./scripts/build-context-preset-cutover-tools.mjs && node ./scripts/build-model-config-cutover-tool.mjs",
    "model-config:preflight": "node ./dist/tools/model-config-cutover.mjs preflight",
    "model-config:apply": "node ./dist/tools/model-config-cutover.mjs apply",
    "memory-v2:build": "node ./scripts/build-memory-v2-cutover-tool.mjs",
    "memory-v2:status": "node ./dist/tools/memory-v2-cutover.mjs status",
    "memory-v2:initialize": "node ./dist/tools/memory-v2-cutover.mjs initialize",
    "memory-v2:preflight": "node ./dist/tools/memory-v2-cutover.mjs preflight",
    "memory-v2:apply": "node ./dist/tools/memory-v2-cutover.mjs apply",
    "memory-v2:bootstrap-verify": "node ./dist/tools/memory-v2-cutover.mjs bootstrap-verify",
    "memory-v2:probe-gate": "node ./dist/tools/memory-v2-cutover.mjs probe-gate",
    "memory-v2:verify": "node ./dist/tools/memory-v2-cutover.mjs verify",
    "memory-v2:eval:build": "node ./scripts/build-memory-evaluation-tool.mjs",
    "memory-v2:evaluate": "node ./dist/tools/memory-evaluation.mjs",
    "start": "bash ./scripts/run-koishi-with-env.sh",
    "start:local": "QQBOT_ENV_FILE=.env.local bash ./scripts/run-koishi-with-env.sh",
    "start:server": "QQBOT_ENV_FILE=.env.server bash ./scripts/run-koishi-with-env.sh",
    "smoke:start": "bash ./scripts/smoke-koishi-start.sh",
    "smoke:chat": "bash ./scripts/smoke-chat-replies.sh",
    "stickers:sync": "node ./scripts/stickers-sync.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@koishijs/plugin-database-sqlite": "4.7.0",
    "@koishijs/plugin-http": "0.6.3",
    "@koishijs/plugin-proxy-agent": "0.3.3",
    "@koishijs/plugin-server": "3.2.9",
    "@langchain/core": "^0.3.80",
    "@lobehub/icons-static-svg": "1.94.0",
    "@lucide/vue": "1.24.0",
    "@napi-rs/canvas": "^0.1.97",
    "cheerio": "1.1.2",
    "cron-parser": "^4.9.0",
    "element-plus": "^2.14.3",
    "jsqr": "1.4.0",
    "koishi": "4.18.11",
    "koishi-plugin-adapter-onebot": "6.9.4",
    "koishi-plugin-canvas": "0.2.2",
    "koishi-plugin-chatluna": "link:../chatluna/packages/core",
    "koishi-plugin-chatluna-agent": "link:../chatluna/packages/extension-agent",
    "koishi-plugin-chatluna-openai-like-adapter": "link:../chatluna/packages/adapter-openai-like",
    "koishi-plugin-chatluna-plugin-common": "link:../chatluna/packages/extension-tools",
    "koishi-plugin-chatluna-storage-service": "1.0.7",
    "koishi-plugin-chatluna-web-run-service": "link:../chatluna/packages/service-web-run",
    "koishi-plugin-cron": "3.1.0",
    "koishi-plugin-downloads": "0.1.3",
    "koishi-plugin-pokemon-battle": "1.1.13",
    "koishi-plugin-puppeteer": "3.9.0",
    "pinia": "^4.0.2",
    "qrcode": "^1.5.4",
    "sm-crypto": "0.4.0",
    "undici": "6.23.0",
    "vue-router": "^5.2.0",
    "yaml": "^2.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.5",
    "typescript": "^5.9.3",
    "vite": "^8.0.1",
    "vitepress": "^1.6.4",
    "vitest": "^4.0.18",
    "vue": "^3.5.39",
    "vue-tsc": "^3.3.7",
    "ws": "^8.21.1"
  }
}
