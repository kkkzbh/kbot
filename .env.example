# Developer-local bot runtime template
# Copy to .env.local only for laptop / workstation tests.
# Server runtime values live in .env.server, based on .env.server.example.
# Keep QQBOT_ENV_BASE_FILE / QQBOT_ENV_OVERRIDE_FILE unset here.

# Core Bot
BOT_OWNER_QQ=2219854433
ONEBOT_SELF_ID=100000001
ONEBOT_WS_ENDPOINT=ws://127.0.0.1:3001
ONEBOT_TOKEN=
KOISHI_HOST=127.0.0.1
KOISHI_PORT=5140
QQBOT_ADMIN_ORIGIN=http://127.0.0.1:5140
QQBOT_ADMIN_SSH_ORIGIN=http://127.0.0.1:5140
SQLITE_PATH=./data/koishi.db
QQBOT_MODEL_CONFIG_PATH=./.runtime/model-config.json
QQBOT_MODEL_CONFIG_KEK_PATH=./.runtime/model-config.kek
CHATLUNA_AGENT_DATA_DIR=./data/chatluna
CHATLUNA_COMMAND_AUTHORITY=3
CHATLUNA_BUNDLED_CONTEXT_PRESET_DIR=./data/chathub/context-presets
CHATLUNA_RUNTIME_CONTEXT_PRESET_DIR=./.runtime/chathub/context-presets
CHATLUNA_BUNDLED_ROLE_PRESET_DIR=./data/chathub/role-presets
CHATLUNA_RUNTIME_ROLE_PRESET_DIR=./.runtime/chathub/role-presets
CHATLUNA_ARCHIVE_DIR=./.runtime/chatluna/archive
# Optional headless browser override for developer-local Puppeteer rendering.
PUPPETEER_EXECUTABLE_PATH=
# Group Natural Trigger (群聊自然触发)
CHAT_NATURAL_TRIGGER_ENABLED=false
QQBOT_REALTIME_MESSAGE_ENABLED=true
QQBOT_REALTIME_MESSAGE_MAX_INJECT_COUNT=12
CHATLUNA_STORAGE_SERVER_PATH=http://127.0.0.1:5140
CHATLUNA_STORAGE_PATH=./data/chatluna-storage
CHATLUNA_STORAGE_BACKEND_PATH=/chatluna-storage
CHATLUNA_STORAGE_TEMP_CACHE_HOURS=720
CHATLUNA_STORAGE_MAX_MB=2048
CHATLUNA_STORAGE_MAX_FILES=2000
QQBOT_ATTACHMENT_MAX_INJECT_COUNT=5
QQBOT_ATTACHMENT_MAX_TEXT_CHARS_PER_FILE=24000
QQBOT_ATTACHMENT_RECENT_CATALOG_SIZE=12
QQBOT_ATTACHMENT_PROJECTION_TEXT_CHARS=1200
QQBOT_ATTACHMENT_REPLAY_TEXT_CHARS=4000
QQBOT_ATTACHMENT_REPLAY_MAX_REFS=5
# 留空表示不在任何群自动触发；请自行填写白名单群号。
CHAT_NATURAL_TRIGGER_GROUPS=
# 留空表示群聊不可用教务系统；私聊仍可使用。
HBU_JW_ALLOWED_GROUPS=
HBU_JW_PUBLIC_BASE_URL=
HBU_JW_BIND_PAGE_PATH=/jw/bind
HBU_JW_BIND_TOKEN_TTL_MS=600000
HBU_JW_CREDENTIAL_KEK_PATH=./.runtime/hbu-jw/credential-kek.key
HBU_JW_AUTO_RELOGIN_ENABLED=true
HBU_JW_KEEP_ALIVE_ENABLED=false
HBU_JW_KEEP_ALIVE_INTERVAL_MS=180000
HBU_JW_KEEP_ALIVE_RECENT_USE_WINDOW_MS=86400000
# 留空表示群聊不可用学习通功能；私聊仍可使用。
CHAOXING_ALLOWED_GROUPS=
CHAOXING_PUBLIC_BASE_URL=
CHAOXING_BIND_PAGE_PATH=/chaoxing/bind
CHAOXING_BIND_TOKEN_TTL_MS=600000
CHAOXING_CREDENTIAL_KEK_PATH=./.runtime/chaoxing/credential-kek.key
CHAOXING_AUTO_RELOGIN_ENABLED=true
CHAOXING_SESSION_VALIDATION_TTL_MS=600000
CHAOXING_REQUEST_INTERVAL_MS=1200
CHAOXING_WORKER_POLL_INTERVAL_MS=5000
CHAOXING_SIGN_WATCH_INTERVAL_MS=15000
CHAOXING_DEADLINE_SYNC_INTERVAL_MS=900000
CHAOXING_DEADLINE_REMINDER_LEAD_MS=86400000
CHAOXING_STUDY_PLAYBACK_RATE=1
CHAOXING_VIDEO_REPORT_INTERVAL_MS=60000
CHAOXING_ANSWER_PROVIDER_URL=
CHAOXING_ANSWER_PROVIDER_API_KEY=
CHAOXING_ANSWER_PROVIDER_TIMEOUT_MS=15000
# 志愿汇与河北大学二课共用一次性绑定页和 KEK；生产环境可复用现有教务 Cloudflare Tunnel 域名。
CAMPUS_AUTH_PUBLIC_BASE_URL=
CAMPUS_AUTH_BIND_PAGE_PATH=/campus/bind
CAMPUS_AUTH_BIND_TOKEN_TTL_MS=600000
CAMPUS_AUTH_ACTION_PAGE_PATH=/campus/action
CAMPUS_AUTH_ACTION_TOKEN_TTL_MS=300000
CAMPUS_AUTH_CREDENTIAL_KEK_PATH=./.runtime/campus-auth/credential-kek.key
CAMPUS_AUTH_MAX_BINDING_ATTEMPTS=5
# 留空表示群聊不可用，私聊仍可使用。
ZYH_ALLOWED_GROUPS=
ZYH_NATURAL_TRIGGER_ENABLED=false
ZYH_NATURAL_TRIGGER_GROUPS=
HBU_SECOND_CLASS_ALLOWED_GROUPS=
HBU_SECOND_CLASS_NATURAL_TRIGGER_ENABLED=false
HBU_SECOND_CLASS_NATURAL_TRIGGER_GROUPS=
# 留空表示群聊不可用原神功能；私聊仍可使用。
GENSHIN_ALLOWED_GROUPS=
GENSHIN_PUBLIC_BASE_URL=
GENSHIN_BIND_PAGE_PATH=/genshin/bind
GENSHIN_BIND_TOKEN_TTL_MS=600000
GENSHIN_CREDENTIAL_KEK_PATH=./.runtime/genshin/credential-kek.key
GENSHIN_AUTO_SIGN_ENABLED=true
GENSHIN_AUTO_SIGN_CRON="10 9 * * *"
GENSHIN_TIMEZONE=Asia/Shanghai
GENSHIN_TAKUMI_APP_VERSION=2.70.1
GENSHIN_SIGN_ACT_ID=e202311201442471
GENSHIN_REDEEM_GAME_VERSION=CNRELWin6.0.0
# 留空表示群聊不暴露文件系统和 bash 工具；请自行填写白名单群号。
CHATLUNA_COMMON_FS_ALLOWED_GROUPS=
CHAT_NATURAL_TRIGGER_ALIASES=祥子,祥,丰川,丰川祥子,saki,saki酱,sakiko
CHAT_NATURAL_TRIGGER_DIRECT_PROBABILITY=0.25
CHAT_NATURAL_TRIGGER_FOCUS_WINDOW_MS=300000
CHAT_NATURAL_TRIGGER_REPLY_INTERVAL_MS=2000
CHAT_NATURAL_TRIGGER_SPAM_WINDOW_MS=10000
CHAT_NATURAL_TRIGGER_SPAM_THRESHOLD=10
CHAT_NATURAL_TRIGGER_SPAM_MUTE_MS=180000
CHAT_NATURAL_TRIGGER_DECISION_MIN_CONFIDENCE=0.62

# Task Automation (智能定时任务)
TASK_AUTOMATION_POLL_MS=30000
TASK_AUTOMATION_MAX_TASKS_PER_USER=20

# QQ Voice (QQ 语音输入/输出)
QQ_VOICE_INPUT_ENABLED=true
QQ_VOICE_OUTPUT_ENABLED=true
QQ_VOICE_ASR_BASE_URL=http://127.0.0.1:5161
QQ_VOICE_ASR_API_KEY=qqbot-voice-asr-token
QQ_VOICE_TTS_BASE_URL=http://127.0.0.1:5162
QQ_VOICE_TTS_API_KEY=qqbot-voice-tts-token
QQ_VOICE_BRIDGE_API_KEY=qqbot-voice-bridge-secret
QQ_VOICE_OUTPUT_LANGUAGE=zh
QQ_VOICE_INPUT_MAX_SECONDS=60
QQ_VOICE_OUTPUT_MAX_WORDS=80
QQ_VOICE_OUTPUT_MAX_SECONDS=45
QQ_VOICE_TRANSCRIBE_TIMEOUT_MS=45000
QQ_VOICE_SYNTH_TIMEOUT_MS=300000
# Laptop-local GPT-SoVITS is configured separately in config/voice-tts.local.env.

# Host LLBot / PMHQ runtime
# run-llbot-host.sh captures QQBOT_HOST_HOME before isolating LLBot HOME.
# Set QQBOT_QQ_CONFIG_MOUNT_SOURCE only when podman inspect cannot resolve the PMHQ QQ volume.
QQBOT_QQ_CONFIG_MOUNT_SOURCE=

# Long Memory
MEMORY_ENABLED=true
MEMORY_MAINTENANCE=false
MEMORY_READ_ENABLED=true
MEMORY_WRITE_ENABLED=true
MEMORY_QUERY_TOPK=8
MEMORY_PROMPT_BUDGET_TOKENS=1200
MEMORY_EMBED_BATCH_SIZE=16
MEMORY_EXTRACT_IDLE_MS=90000
MEMORY_EXTRACT_MESSAGE_BATCH=12
MEMORY_ARCHIVE_DAYS=90
MEMORY_MAX_JOB_RETRIES=5
MEMORY_JOB_LOCK_TIMEOUT_MS=300000
MEMORY_MAX_FACTS=8
MEMORY_MAX_EPISODES=8

# ChatLuna Search Service (Tavily)
CHATLUNA_SEARCH_SERVICE_ENABLED=true
CHATLUNA_SEARCH_SERVICE_MODE=live
CHATLUNA_SEARCH_SERVICE_TOPK=5
CHATLUNA_SEARCH_SERVICE_PER_DOMAIN_LIMIT=2
CHATLUNA_SEARCH_SERVICE_TAVILY_API_KEY=
CHATLUNA_SEARCH_SERVICE_ARTIFACT_DIR=./data/chatluna/web-artifacts

# ChatLuna Common Tools (通用工具插件)
CHATLUNA_COMMON_THINK=false
CHATLUNA_COMMON_SEND=true
CHATLUNA_COMMON_TODOS=false
CHATLUNA_COMMON_CHAT=true
CHATLUNA_COMMON_FS=false
CHATLUNA_COMMON_FS_SCOPE_PATH=
CHATLUNA_COMMON_COMMAND=false
CHATLUNA_COMMON_COMMAND_AUTO_EXECUTE=false
CHATLUNA_COMMON_CRON=false
CHATLUNA_COMMON_GROUP=false

# Sticker (表情包)
CHATLUNA_STICKER_DIR=./data/chathub/stickers

# ChatLuna Live Reply (发送期可中断续写)
QQBOT_REPLY_INTERRUPT_ENABLED=false
QQBOT_REPLY_COLLECT_WINDOW_MS=400
QQBOT_REPLY_MAX_PENDING_INPUTS=8

# PMHQ container + host LLBot runtime
PMHQ_IMAGE=docker.io/linyuchen/pmhq
PMHQ_TAG=latest
LLBOT_VERSION=7.12.15
LLBOT_RUNTIME_DIR=./.runtime/llbot
# Optional override for PMHQ QQ volume mount source when podman inspect is unavailable.
QQBOT_QQ_CONFIG_MOUNT_SOURCE=
ENABLE_HEADLESS=false
AUTO_LOGIN_QQ=
LLONEBOT_DATA_DIR=./.runtime/llonebot
LLONEBOT_DISABLE_WEBUI_AUTH=true
PMHQ_BIND_HOST=127.0.0.1
PMHQ_PORT=13000
LLONEBOT_WEBUI_PORT=3080
LLONEBOT_WS_PORT=3001
VOICE_ASR_PORT=5161
VOICE_ASR_MODEL=small
VOICE_ASR_COMPUTE_TYPE=int8
TZ=Asia/Shanghai
